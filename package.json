{
  "name": "@mininglamp-oss/octo-channel-gateway",
  "version": "0.0.0",
  "description": "Independent Octo Channel Gateway SDK and CLI for an existing Runtime Kernel",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mininglamp-OSS/octo-channel-gateway.git"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "octo-channel-gateway": "dist/apps/cli/src/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r run build && node scripts/assemble-root.mjs",
    "typecheck": "pnpm -r run build && pnpm -r run typecheck",
    "test": "pnpm run build && node --test test/*.test.js",
    "prepack": "node scripts/require-release-pack.mjs",
    "lint:spec": "python3 .octospec/scripts/lint.py",
    "docs:check": "tsc -p docs/examples/tsconfig.json && node scripts/check-developer-docs.mjs && node --test docs/checks/*.test.mjs",
    "test:ci": "node --test --test-concurrency=4 --test-timeout=20000 test/*.test.js test/manual/*.test.mjs test/release-ci.test.mjs",
    "pack:release": "node scripts/pack-release.mjs",
    "test:package": "node scripts/verify-distribution.mjs"
  },
  "dependencies": {
    "@mininglamp-oss/octo-channel-gateway-sdk": "workspace:*",
    "@mininglamp-oss/octo-channel-gateway-cli": "workspace:*",
    "@mininglamp-oss/octo-runtime-client": "^1.1.14",
    "commander": "^15.0.0",
    "iconv-lite": "0.7.3",
    "mdast-util-from-markdown": "^2.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@mininglamp-oss/octo-runtime": "^1.1.14",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2"
  }
}
